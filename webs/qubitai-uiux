        // QUBIT CREDITS & AGENT STATUS LOGIC
        let creditBalance = 1280;
        let isAgentActive = true;

        function addQubitCredits() {
            creditBalance += 500;
            document.getElementById('qubitCreditBalance').innerText = creditBalance.toLocaleString();
            showToast("500 Qubit Credit이 성공적으로 충전되었습니다!", "success");
