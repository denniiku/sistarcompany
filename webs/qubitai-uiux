            const pct = Math.min(100, (numeric / 1000000) * 100);
            document.getElementById('callGaugeBar').style.width = pct + "%";

            // Calculate cost: $0.001 per call
            const estCost = (numeric * 0.001).toFixed(2);
            document.getElementById('estimatedCostText').innerHTML = `$${estCost} <span class="text-xs text-gray-400 font-normal">USD</span>`;
        }

