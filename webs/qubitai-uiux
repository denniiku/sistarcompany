        // TOAST NOTIFICATION UTILITY
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            let bg = "bg-gray-900 border-gray-700 text-gray-200";
            if (type === 'success') bg = "bg-emerald-950/90 border-emerald-500/40 text-emerald-300";
            if (type === 'warning') bg = "bg-amber-950/90 border-amber-500/40 text-amber-300";
            if (type === 'info') bg = "bg-cyan-950/90 border-cyan-500/40 text-cyan-300";

            toast.className = `glass-panel px-4 py-2.5 rounded-xl border text-xs font-semibold shadow-2xl flex items-center gap-2 pointer-events-auto animate-fade-in ${bg}`;
            toast.innerHTML = `
                <i class="fa-solid fa-circle-info"></i>
                <span>${message}</span>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                toast.remove();
            }, 3500);
        }
