<!DOCTYPE html>
<html lang="ko" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Qubit AI - UI/UX Design Visualization</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Chart.js for real-time B2B graphs -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Noto Sans KR', 'Inter', 'sans-serif'],
                        mono: ['Fira Code', 'monospace'],
                    },
                    colors: {
                        qubit: {
                            50: '#f0fdfa',
                            500: '#14b8a6',
                            600: '#0d9488',
                            900: '#134e4a',
                        },
                        quantum: {
                            cyan: '#06b6d4',
                            purple: '#a855f7',
                            emerald: '#10b981',
                            amber: '#f59e0b',
                        }
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate',
                        'float': 'float 4s ease-in-out infinite',
                    },
                    keyframes: {
                        glow: {
                            '0%': { boxShadow: '0 0 10px rgba(6, 182, 212, 0.3)' },
                            '100%': { boxShadow: '0 0 25px rgba(168, 85, 247, 0.7)' }
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-6px)' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #030712;
            color: #f3f4f6;
            font-family: 'Noto Sans KR', 'Inter', sans-serif;
            overflow-x: hidden;
        }

        .glass-panel {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(31, 41, 55, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0f19;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f2937;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #374151;
        }

        /* Code editor style */
        .code-line {
            counter-increment: line;
        }
        .code-line::before {
            content: counter(line);
            display: inline-block;
            width: 2rem;
            margin-right: 1rem;
            color: #4b5563;
            text-align: right;
            font-size: 0.75rem;
        }

        /* Canvas Overlay glow */
        #entanglementCanvas {
            background: radial-gradient(circle at center, rgba(17, 24, 39, 0.9) 0%, rgba(3, 7, 18, 1) 100%);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-cyan-500 selection:text-black">

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 border-b border-gray-800/80 bg-gray-950/80 backdrop-blur-xl px-4 lg:px-8 py-3">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
            
            <!-- Brand Logo -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-indigo-500 to-purple-600 p-0.5 shadow-lg shadow-cyan-500/20">
                    <div class="w-full h-full bg-gray-950 rounded-[10px] flex items-center justify-center">
                        <i class="fa-solid fa-atom text-cyan-400 text-lg animate-spin" style="animation-duration: 12s;"></i>
                    </div>
                </div>
                <div>
                    <h1 class="text-base font-bold bg-gradient-to-r from-white via-gray-200 to-cyan-300 bg-clip-text text-transparent flex items-center gap-2">
                        Qubit AI System
                        <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">UI/UX Showcase</span>
                    </h1>
                    <p class="text-xs text-gray-400">PWA Landing/Dashboard & B2B Enterprise Portal Visualization</p>
                </div>
            </div>

            <!-- View Switcher Tabs -->
            <div class="flex items-center gap-1.5 bg-gray-900/90 p-1 rounded-xl border border-gray-800 text-xs font-medium">
                <!-- End-User Tab -->
                <button onclick="switchPortal('user')" id="btn-portal-user" class="portal-tab px-3.5 py-2 rounded-lg bg-cyan-600 text-white font-semibold transition flex items-center gap-2 shadow-md shadow-cyan-600/20">
                    <i class="fa-solid fa-user text-xs"></i>
                    <span>A. 엔드유저 Web/PWA</span>
                </button>
                
                <!-- B2B Tab -->
                <button onclick="switchPortal('b2b')" id="btn-portal-b2b" class="portal-tab px-3.5 py-2 rounded-lg text-gray-400 hover:text-white transition flex items-center gap-2">
                    <i class="fa-solid fa-building text-xs"></i>
                    <span>B. B2B 파트너 전용 포털</span>
                </button>
            </div>

        </div>
    </header>

    <!-- Sub Navigation Controls Bar -->
    <div class="bg-gray-900/50 border-b border-gray-800/60 py-2.5 px-4 lg:px-8">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-xs">
            
            <!-- User Sub-Views Switcher -->
            <div id="subnav-user" class="flex items-center gap-2">
                <span class="text-gray-500 font-mono text-[11px] uppercase mr-1">View Mode:</span>
                <button onclick="switchUserSubView('landing')" id="btn-user-landing" class="px-3 py-1.5 rounded-lg bg-gray-800 text-cyan-300 border border-cyan-500/30 font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-bolt text-amber-400 text-[11px]"></i>
                    <span>랜딩 페이지 (MPA)</span>
                </button>
                <button onclick="switchUserSubView('dashboard')" id="btn-user-dashboard" class="px-3 py-1.5 rounded-lg text-gray-400 hover:bg-gray-800 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-gauge-high text-cyan-400 text-[11px]"></i>
                    <span>사용자 대시보드 & My Page (SPA)</span>
                </button>
            </div>

            <!-- B2B Sub-Views Switcher (Hidden by default) -->
            <div id="subnav-b2b" class="hidden flex items-center gap-2">
                <span class="text-gray-500 font-mono text-[11px] uppercase mr-1">B2B Panel:</span>
                <button onclick="switchB2bSubView('metering')" id="btn-b2b-metering" class="px-3 py-1.5 rounded-lg bg-gray-800 text-indigo-300 border border-indigo-500/30 font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-key text-indigo-400 text-[11px]"></i>
                    <span>API Keys & Metered Billing</span>
                </button>
                <button onclick="switchB2bSubView('sandbox')" id="btn-b2b-sandbox" class="px-3 py-1.5 rounded-lg text-gray-400 hover:bg-gray-800 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-terminal text-emerald-400 text-[11px]"></i>
                    <span>Interactive API Sandbox ($t=0$)</span>
                </button>
            </div>

            <!-- Device Target Tag -->
            <div class="hidden sm:flex items-center gap-2 text-gray-400 font-mono text-[11px]">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Responsive Viewport Active</span>
            </div>

        </div>
    </div>

    <!-- MAIN CONTAINER -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 relative">

        <!-- ========================================== -->
        <!-- PORTAL A: END-USER WEB / PWA               -->
        <!-- ========================================== -->
        <div id="portal-user-wrapper" class="space-y-6">

            <!-- SUB VIEW 1: LANDING PAGE (MPA) -->
            <div id="view-user-landing" class="space-y-8">
                
                <!-- Performance Speed Banner -->
                <div class="glass-panel rounded-2xl p-4 border border-cyan-500/20 flex flex-wrap items-center justify-between gap-3 text-xs bg-gradient-to-r from-cyan-950/30 via-gray-900 to-purple-950/20">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">
                            <i class="fa-solid fa-gauge-simple-high"></i>
                        </span>
                        <div>
                            <span class="font-bold text-gray-200">초고속 MPA 랜딩 성능 최적화:</span>
                            <span class="text-gray-400 ml-1">초기 로딩 속도 <strong class="text-emerald-400 font-mono">0.8초 이내</strong> 달성 (Lightweight Edge SSR)</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 font-mono text-[11px]">
                        <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">Lighthouse 99</span>
                        <span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">Edge CDN</span>
                    </div>
                </div>

                <!-- Hero Banner Section -->
                <div class="glass-panel rounded-3xl p-8 lg:p-12 relative overflow-hidden border border-gray-800 text-center space-y-6">
                    <!-- Background Glow Elements -->
                    <div class="absolute -top-24 -left-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-semibold">
                        <i class="fa-solid fa-sparkles text-amber-400"></i>
                        <span>One Spark AI 비즈니스 연동 엔진</span>
                    </div>

                    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white max-w-3xl mx-auto leading-tight">
                        단 한 줄의 아이디어가 <br/>
                        <span class="bg-gradient-to-r from-cyan-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent">양자 AI 비즈니스</span>가 되는 순간
                    </h1>

                    <p class="text-sm sm:text-base text-gray-300 max-w-xl mx-auto leading-relaxed">
                        PWA 웹 앱 설치 없이 즉시 실행 가능한 초경량 AI 백엔드 오케스트레이터. 아이디어 입력부터 Dify AI 에이전트 연동까지 100ms 내에 시작하세요.
                    </p>

                    <!-- Core CTA Buttons & Interactive Input Box -->
                    <div class="max-w-2xl mx-auto space-y-4 pt-4">
                        <!-- Primary CTAs -->
                        <div class="flex flex-wrap items-center justify-center gap-3">
                            <!-- PWA Install Button -->
                            <button onclick="triggerPwaInstallModal()" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-gray-950 font-extrabold text-sm transition shadow-lg shadow-cyan-500/25 flex items-center gap-2.5 animate-pulse-slow">
                                <i class="fa-solid fa-download text-base"></i>
                                <span>PWA 앱 설치하기 (Instantly)</span>
                            </button>
                            <a href="#spark-test" class="px-5 py-3.5 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold text-sm border border-gray-700 transition flex items-center gap-2">
                                <i class="fa-solid fa-play text-xs text-amber-400"></i>
                                <span>AI 테스트 먼저 둘러보기</span>
                            </a>
                        </div>

                        <!-- One Spark AI Business Test Input Box -->
                        <div id="spark-test" class="mt-8 pt-6 border-t border-gray-800/80 text-left space-y-3">
                            <label class="block text-xs font-bold uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                                <i class="fa-solid fa-bolt text-amber-400"></i>
                                <span>One Spark AI 비즈니스 입수 매개변수 테스트</span>
                            </label>
                            
                            <div class="relative flex items-center">
                                <input type="text" id="landingSparkInput" placeholder="예: 소상공인 대상 실시간 재무 과금 예측 AI 서비스..." 
                                       class="w-full bg-gray-950 border border-gray-700 focus:border-cyan-500 rounded-xl px-4 py-3.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 pr-32">
                                <button onclick="runSparkTest()" class="absolute right-2 px-4 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-xs transition flex items-center gap-1.5 shadow-md">
                                    <span>진단 실행</span>
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </button>
                            </div>
                            <p class="text-[11px] text-gray-400 flex items-center justify-between">
                                <span>* 입력 시 Dify AI Engine이 실시간 사업성 파이프라인 수치를 추산합니다.</span>
                                <span class="font-mono text-cyan-400">Latency &lt; 120ms</span>
                            </p>
                        </div>

                        <!-- Spark Test Result Display Box -->
                        <div id="sparkResultBox" class="hidden glass-card rounded-xl p-4 border border-cyan-500/30 text-left space-y-3 animate-fade-in">
                            <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
                                    <span class="text-xs font-bold text-gray-200">Dify AI 에이전트 초기 진단 완료</span>
                                </div>
                                <span class="text-[10px] font-mono text-cyan-300 bg-cyan-500/10 px-2 py-0.5 rounded">Analysis Score: 94/100</span>
                            </div>
                            <div class="grid grid-cols-3 gap-2 text-center text-xs font-mono">
                                <div class="p-2 rounded bg-gray-900/80 border border-gray-800">
                                    <div class="text-gray-400 text-[10px]">추천 LLM</div>
                                    <div class="text-emerald-400 font-bold mt-0.5">Qwen 2.5 Coder</div>
                                </div>
                                <div class="p-2 rounded bg-gray-900/80 border border-gray-800">
                                    <div class="text-gray-400 text-[10px]">예상 크레딧</div>
                                    <div class="text-amber-400 font-bold mt-0.5">1.2 Qubit / call</div>
                                </div>
                                <div class="p-2 rounded bg-gray-900/80 border border-gray-800">
                                    <div class="text-gray-400 text-[10px]">RAG 지식 인덱스</div>
                                    <div class="text-cyan-400 font-bold mt-0.5">Ready</div>
                                </div>
                            </div>
                            <button onclick="switchUserSubView('dashboard')" class="w-full py-2 bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 rounded-lg text-xs font-bold transition text-center border border-cyan-500/30">
                                사용자 대시보드(SPA)에서 연결망 노드로 확인하기 ➔
                            </button>
                        </div>
                    </div>
                </div>

            </div>

            <!-- SUB VIEW 2: USER DASHBOARD & MY PAGE (SPA - NATIVE PWA FEEL) -->
            <div id="view-user-dashboard" class="hidden space-y-6">

                <!-- TOP HEADER BAR (CREDITS & AI AGENT STATUS) -->
                <div class="glass-panel rounded-2xl p-4 lg:px-6 border border-gray-800 flex flex-wrap items-center justify-between gap-4">
                    
                    <!-- Left User Info -->
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-indigo-600 p-0.5">
                            <img src="https://placehold.co/80x80/0f172a/38bdf8?text=USER" alt="User Avatar" class="w-full h-full rounded-[10px] object-cover">
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-sm font-bold text-gray-100">퀀텀 이더 (User Workspace)</h2>
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 font-mono border border-cyan-500/20">PWA Native Mode</span>
                            </div>
                            <p class="text-xs text-gray-400">양자 얽힘 노드 파이프라인 관리자</p>
                        </div>
                    </div>

                    <!-- Right Stats (Qubit Credits + AI Agent Indicator Switch) -->
                    <div class="flex items-center gap-4 flex-wrap">
                        
                        <!-- Qubit Credit Balance Indicator -->
                        <div class="px-3.5 py-2 rounded-xl bg-gray-900/90 border border-gray-800 flex items-center gap-3 shadow-inner">
                            <div class="w-7 h-7 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center text-xs">
                                <i class="fa-solid fa-coins"></i>
                            </div>
                            <div>
                                <div class="text-[10px] text-gray-400 font-mono">Qubit Credit 잔액</div>
                                <div class="text-xs font-bold text-amber-300 font-mono flex items-center gap-1">
                                    <span id="qubitCreditBalance">1,280</span>
                                    <span class="text-[10px] text-amber-500/80">Qubit</span>
                                </div>
                            </div>
                            <button onclick="addQubitCredits()" class="text-[10px] px-2 py-1 rounded bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 transition font-mono border border-amber-500/30 ml-1">
                                + 충전
                            </button>
                        </div>

                        <!-- AI Agent Status Indicator (Green/Red Toggleable) -->
                        <div class="px-3.5 py-2 rounded-xl bg-gray-900/90 border border-gray-800 flex items-center gap-3">
                            <div id="agentStatusPulse" class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></div>
                            <div>
                                <div class="text-[10px] text-gray-400 font-mono">AI 에이전트 가동 상태</div>
                                <div id="agentStatusText" class="text-xs font-bold text-emerald-400 font-mono">
                                    ACTIVE (Green)
                                </div>
                            </div>
                            <button onclick="toggleAgentStatus()" title="가동 상태 수동 토글" class="text-[10px] px-2 py-1 rounded bg-gray-800 hover:bg-gray-700 text-gray-300 font-mono border border-gray-700 ml-1">
                                Status Switch
                            </button>
                        </div>

                    </div>
                </div>

                <!-- MAIN CANVAS: ENTANGLEMENT GRAPH (양자 얽힘 연결망) -->
                <div class="glass-panel rounded-3xl border border-gray-800 p-4 lg:p-6 relative space-y-3">
                    
                    <div class="flex items-center justify-between px-2">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-diagram-project text-cyan-400 text-sm"></i>
                            <h3 class="text-sm font-bold text-gray-200">양자 얽힘 연결망 (Entanglement Graph)</h3>
                            <span class="text-[10px] text-gray-400 font-mono">(노드 클릭으로 상세 정보 확인)</span>
                        </div>
                        <div class="flex items-center gap-2 font-mono text-[11px]">
                            <button onclick="resetGraph()" class="px-2.5 py-1 rounded bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700 transition">
                                <i class="fa-solid fa-arrows-rotate text-[10px] mr-1"></i> 그래프 리셋
                            </button>
                        </div>
                    </div>

                    <!-- Interactive Physics Node Canvas Box -->
                    <div class="relative w-full h-[420px] rounded-2xl overflow-hidden border border-gray-800/80 shadow-2xl">
                        <canvas id="entanglementCanvas" class="w-full h-full block cursor-pointer"></canvas>
                        
                        <!-- Floating Node Info Inspector Drawer -->
                        <div id="nodeInfoDrawer" class="hidden absolute top-4 right-4 w-72 glass-panel bg-gray-950/90 rounded-2xl p-4 border border-cyan-500/40 text-xs space-y-3 shadow-2xl">
                            <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                                <span class="font-bold text-cyan-300" id="drawerTitle">Node Selected</span>
                                <button onclick="closeDrawer()" class="text-gray-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                            <div class="space-y-1.5 text-gray-300">
                                <div><strong>유형:</strong> <span id="drawerType" class="font-mono text-gray-400">Project Engine</span></div>
                                <div><strong>상태:</strong> <span id="drawerStatus" class="font-mono text-emerald-400">Synced ($t=0$)</span></div>
                                <div><strong>크레딧 소모:</strong> <span id="drawerCost" class="font-mono text-amber-300">0.4 Qubit/req</span></div>
                                <div><strong>Dify Workflow:</strong> <span id="drawerDify" class="font-mono text-indigo-300">RAG Agent v2</span></div>
                            </div>
                            <div class="pt-2 border-t border-gray-800">
                                <button onclick="simulateNodeRun()" class="w-full py-1.5 rounded bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-[11px] transition">
                                    노드 단독 테스트 실행 ⚡
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- BOTTOM FLOATING BAR (SINGLE LINE IDEA INPUT TO DIFY) -->
                    <div class="relative pt-2">
                        <div class="glass-panel bg-gray-950/90 border border-cyan-500/30 rounded-2xl p-3 shadow-2xl flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-indigo-600 flex items-center justify-center text-gray-950 font-bold shrink-0 shadow-md shadow-cyan-500/20">
                                <i class="fa-solid fa-wand-magic-sparkles text-sm"></i>
