        // QUANTUM ENTANGLEMENT CANVAS GRAPH SYSTEM
        let canvas, ctx;
        let nodes = [];
        let canvasInitialized = false;

        function initCanvasIfNeeded() {
            if (canvasInitialized) return;
            canvasInitialized = true;

            canvas = document.getElementById('entanglementCanvas');
            ctx = canvas.getContext('2d');

            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            // Populate Default Nodes
            nodes = [
                { id: 1, name: "One-Spark Orchestrator", x: 0.5, y: 0.5, radius: 24, color: "#06b6d4", type: "Core Engine", cost: "0.8 Qubit", dify: "Workflow Core" },
                { id: 2, name: "Project FinTech", x: 0.25, y: 0.3, radius: 16, color: "#a855f7", type: "RAG Bot", cost: "0.4 Qubit", dify: "FinTech Prompt" },
                { id: 3, name: "Project Metering", x: 0.75, y: 0.35, radius: 18, color: "#10b981", type: "Billing Sync", cost: "0.2 Qubit", dify: "Billing Engine" },
                { id: 4, name: "Qwen 2.5 Coder", x: 0.35, y: 0.75, radius: 20, color: "#f59e0b", type: "LLM Local", cost: "0.0 Qubit (Free)", dify: "Local Ollama" },
                { id: 5, name: "Firestore Node", x: 0.7, y: 0.7, radius: 15, color: "#3b82f6", type: "NoSQL DB", cost: "0.1 Qubit", dify: "DB Sync" }
            ];

            canvas.addEventListener('click', handleCanvasClick);
            requestAnimationFrame(renderGraph);
        }

        function resizeCanvas() {
            if (!canvas) return;
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
        }

        function renderGraph() {
            if (!ctx) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const w = canvas.width;
            const h = canvas.height;

            // Draw Connection Entanglement Lines
            const core = nodes[0];
            const cx = core.x * w;
            const cy = core.y * h;

            for (let i = 1; i < nodes.length; i++) {
                const target = nodes[i];
                const tx = target.x * w;
                const ty = target.y * h;

                ctx.beginPath();
                ctx.moveTo(cx, cy);
                ctx.lineTo(tx, ty);
                ctx.strokeStyle = "rgba(6, 182, 212, 0.25)";
                ctx.lineWidth = 1.5;
                ctx.stroke();

                // Animated Particle on Line
                const time = Date.now() * 0.001;
                const progress = (time + i * 0.4) % 1;
                const px = cx + (tx - cx) * progress;
                const py = cy + (ty - cy) * progress;

                ctx.beginPath();
                ctx.arc(px, py, 3, 0, Math.PI * 2);
                ctx.fillStyle = "#a855f7";
                ctx.shadowColor = "#a855f7";
                ctx.shadowBlur = 8;
                ctx.fill();
                ctx.shadowBlur = 0;
            }

            // Draw Nodes
            nodes.forEach(node => {
                const nx = node.x * w;
                const ny = node.y * h;

                // Outer Pulse
                ctx.beginPath();
                ctx.arc(nx, ny, node.radius + 6, 0, Math.PI * 2);
                ctx.fillStyle = node.color + "22";
                ctx.fill();

                // Node Circle
                ctx.beginPath();
                ctx.arc(nx, ny, node.radius, 0, Math.PI * 2);
                ctx.fillStyle = node.color;
                ctx.shadowColor = node.color;
                ctx.shadowBlur = 12;
                ctx.fill();
                ctx.shadowBlur = 0;

                // Node Label
                ctx.font = "11px Inter, sans-serif";
                ctx.fillStyle = "#f3f4f6";
                ctx.textAlign = "center";
                ctx.fillText(node.name, nx, ny + node.radius + 16);
            });

            requestAnimationFrame(renderGraph);
        }

        let selectedNode = null;
        function handleCanvasClick(e) {
            const rect = canvas.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const clickY = e.clientY - rect.top;

            const w = canvas.width;
            const h = canvas.height;

            selectedNode = null;

            nodes.forEach(node => {
                const nx = node.x * w;
                const ny = node.y * h;
                const dist = Math.hypot(clickX - nx, clickY - ny);

                if (dist <= node.radius + 6) {
                    selectedNode = node;
                }
            });

            if (selectedNode) {
                document.getElementById('drawerTitle').innerText = selectedNode.name;
                document.getElementById('drawerType').innerText = selectedNode.type;
                document.getElementById('drawerCost').innerText = selectedNode.cost;
                document.getElementById('drawerDify').innerText = selectedNode.dify;
                document.getElementById('nodeInfoDrawer').classList.remove('hidden');
            }
        }

        function closeDrawer() {
            document.getElementById('nodeInfoDrawer').classList.add('hidden');
        }

        function simulateNodeRun() {
            if (!selectedNode) return;
            showToast(`${selectedNode.name} 노드 테스트 실행 완료 (Latency: 18ms)`, "success");
        }

        function sendIdeaToDify() {
            const input = document.getElementById('floatingIdeaInput');
            const text = input.value.trim();
            if (!text) {
                showToast("아이디어를 입력해주세요!", "warning");
                return;
            }

            // Create dynamic node
            const newNode = {
                id: nodes.length + 1,
                name: text.length > 15 ? text.substring(0, 15) + "..." : text,
                x: 0.2 + Math.random() * 0.6,
                y: 0.2 + Math.random() * 0.6,
                radius: 14,
                color: "#10b981",
                type: "Dify Generated Project",
                cost: "0.5 Qubit",
                dify: "Custom Dify Workflow"
            };

            nodes.push(newNode);
            input.value = "";
            showToast("Dify 백엔드로 전달되어 연결망에 새로운 노드가 생성되었습니다!", "success");
        }

        function resetGraph() {
            initCanvasIfNeeded();
            nodes = nodes.slice(0, 5);
            closeDrawer();
            showToast("연결망 그래프가 초기화되었습니다.", "info");
        }

