                    "단 한 줄의 명령어로 글로벌 CDN 호스팅 자동 배포",
                    "롤백(Rollback) 지원으로 즉시 이전 버전 복원 가능",
                    "SSL Zertificate 및 커스텀 도메인 자동 갱신"
                ],
                configSnippet: `# Firebase CLI Deploy Command\nfirebase deploy --only hosting,functions --token "$FIREBASE_TOKEN"`
            }
        };

        // Open Node Technical Modal
        function showDetail(nodeId) {
            const data = nodeData[nodeId];
            if (!data) return;

            const modalContent = document.getElementById('modalContent');
            
            modalContent.innerHTML = `
                <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-xl">
                            <i class="fa-solid ${data.icon}"></i>
                        </div>
                        <div>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 uppercase">${data.category}</span>
                            <h3 class="text-lg font-bold text-slate-100">${data.title}</h3>
                        </div>
                    </div>
                </div>

                <p class="text-sm text-slate-300 leading-relaxed">${data.desc}</p>

                <div class="space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">주요 기능 및 역할 (Key Features)</h4>
                    <ul class="space-y-1.5 text-xs text-slate-300">
                        ${data.features.map(f => `<li class="flex items-start gap-2"><i class="fa-solid fa-check text-emerald-400 mt-0.5"></i> <span>${f}</span></li>`).join('')}
                    </ul>
                </div>

                <div class="space-y-2">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">기술 스택 (Tech Stack)</h4>
                    <div class="flex flex-wrap gap-2">
                        ${data.techStack.map(t => `<span class="px-2.5 py-1 rounded-md bg-slate-800 border border-slate-700 text-xs font-mono text-slate-200">${t}</span>`).join('')}
                    </div>
                </div>

                ${data.configSnippet ? `
                <div class="space-y-2">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">코드 / 설정 예시 (Snippet)</h4>
                    <pre class="p-3 rounded-lg bg-slate-950 border border-slate-800 text-emerald-400 font-mono text-xs overflow-x-auto"><code>${escapeHtml(data.configSnippet)}</code></pre>
                </div>` : ''}
            `;

            document.getElementById('detailModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('detailModal').classList.add('hidden');
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        // Simulation Menu Toggle
        function toggleSimulationMenu() {
            const menu = document.getElementById('simMenu');
            menu.classList.toggle('hidden');
        }

        let simInterval = null;

        // Run Traffic Flow Simulation
        function runSimulation(type) {
            toggleSimulationMenu();
            stopSimulation();

            const simBanner = document.getElementById('simBanner');
            const simTitle = document.getElementById('simTitle');
            const simDescription = document.getElementById('simDescription');
            simBanner.classList.remove('hidden');

            let steps = [];

            if (type === 'enduser') {
                simTitle.innerText = "시뮬레이션: 1. End-User 서비스 요청 플로우";
                simDescription.innerText = "PWA 클라이언트 ➔ Firebase Hosting ➔ Auth 검증 ➔ Dify Workflow RAG 연동 진행 중...";
                steps = ['node-enduser', 'node-auth', 'node-gcp', 'node-dify', 'node-db'];
            } else if (type === 'b2b') {
                simTitle.innerText = "시뮬레이션: 2. B2B 파트너 API 통합 & 과금 플로우";
                simDescription.innerText = "B2B 파트너 API Key 전달 ➔ Cloudflare Edge Rate-Limiting ➔ Local Ollama Qwen 2.5 ➔ Firestore Billing Log 트랜잭션 기록...";
                steps = ['node-b2b', 'node-edge', 'node-gcp', 'node-ollama', 'node-db'];
            } else if (type === 'cicd') {
                simTitle.innerText = "시뮬레이션: 3. CI/CD 자동 배포 파이프라인";
                simDescription.innerText = "AI Studio 코딩 완료 ➔ GitHub Push/CI 테스트 ➔ Firebase CLI 자동 배포 준비...";
                steps = ['node-aistudio', 'node-github', 'node-firebasecli', 'node-enduser'];
            }

            let currentStepIndex = 0;

            function highlightNextStep() {
                // Clear active states
                document.querySelectorAll('.node-card').forEach(el => {
                    el.classList.remove('ring-2', 'ring-indigo-500', 'ring-emerald-500', 'ring-amber-500', 'shadow-2xl', 'scale-105');
                });

                if (currentStepIndex >= steps.length) {
                    currentStepIndex = 0; // Loop simulation
                }

                const targetId = steps[currentStepIndex];
                const activeNode = document.getElementById(targetId);
                if (activeNode) {
                    activeNode.classList.add('ring-2', 'ring-indigo-500', 'shadow-2xl', 'scale-105');
                    activeNode.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }

                currentStepIndex++;
            }

            highlightNextStep();
            simInterval = setInterval(highlightNextStep, 1500);
        }

        function stopSimulation() {
            if (simInterval) clearInterval(simInterval);
            document.getElementById('simBanner').classList.add('hidden');
            document.querySelectorAll('.node-card').forEach(el => {
                el.classList.remove('ring-2', 'ring-indigo-500', 'ring-emerald-500', 'ring-amber-500', 'shadow-2xl', 'scale-105');
            });
        }

        // Category Filter Logic
        function filterCategory(category) {
            // Highlight active filter button
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white');
                btn.classList.add('bg-slate-800', 'text-slate-300');
            });
            event.target.classList.remove('bg-slate-800', 'text-slate-300');
            event.target.classList.add('bg-indigo-600', 'text-white');

            const layers = document.querySelectorAll('.arch-layer');
            layers.forEach(layer => {
                if (category === 'all' || layer.getAttribute('data-category') === category) {
                    layer.style.display = 'block';
                } else {
                    layer.style.display = 'none';
                }
            });
        }

        // Search Input Filter
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            const nodeCards = document.querySelectorAll('.node-card');

            nodeCards.forEach(card => {
                const text = card.innerText.toLowerCase();
                if (query === '' || text.includes(query)) {
                    card.style.opacity = '1';
                    card.classList.remove('grayscale');
                } else {
                    card.style.opacity = '0.25';
                    card.classList.add('grayscale');
                }
            });
        });

        // View Mode Switch (Diagram vs Grid)
        let isGridView = false;
        function toggleViewMode() {
            isGridView = !isGridView;
            const diagramView = document.getElementById('diagramView');
            const gridView = document.getElementById('gridView');
            const viewModeText = document.getElementById('viewModeText');

            if (isGridView) {
                diagramView.classList.add('hidden');
                gridView.classList.remove('hidden');
                viewModeText.innerText = "플로우 다이어그램 전환";
                renderGridView();
            } else {
                diagramView.classList.remove('hidden');
                gridView.classList.add('hidden');
                viewModeText.innerText = "카드 뷰 전환";
            }
        }

        function renderGridView() {
            const gridView = document.getElementById('gridView');
            gridView.innerHTML = '';

            Object.keys(nodeData).forEach(key => {
                const item = nodeData[key];
                const card = document.createElement('div');
                card.className = "glass-panel bg-slate-900/80 rounded-xl p-5 border border-slate-800 hover:border-indigo-500/50 transition cursor-pointer flex flex-col justify-between";
                card.onclick = () => showDetail(key);

                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-lg">
                                <i class="fa-solid ${item.icon}"></i>
                            </div>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">${item.category}</span>
                        </div>
                        <h3 class="text-sm font-bold text-slate-100 mb-1">${item.title}</h3>
                        <p class="text-xs text-slate-400 line-clamp-3">${item.desc}</p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs text-indigo-400 font-medium">
                        <span>상세 스펙 보기</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                `;
                gridView.appendChild(card);
            });
        }

        // Keyboard ESC Listener to close modal
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
    </script>
</body>
</html>
