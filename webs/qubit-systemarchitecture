<!DOCTYPE html>
<html lang="ko" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>시스템 아키텍처 인포그래픽 - System Architecture Dashboard</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Noto Sans KR', 'Inter', 'sans-serif'],
                        mono: ['Fira Code', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        },
                        gcp: '#4285F4',
                        firebase: '#FFCA28',
                        cloudflare: '#F38020',
                        dify: '#1890FF',
                        ollama: '#22c55e',
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'flow-line': 'dash 20s linear infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate',
                    },
                    keyframes: {
                        glow: {
                            '0%': { boxShadow: '0 0 5px rgba(59, 130, 246, 0.3)' },
                            '100%': { boxShadow: '0 0 20px rgba(59, 130, 246, 0.8), 0 0 30px rgba(99, 102, 241, 0.5)' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: 'Noto Sans KR', 'Inter', sans-serif;
        }

        /* Glassmorphism card effects */
        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-panel:hover {
            border-color: rgba(99, 102, 241, 0.4);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        /* Custom connection line animations */
        .flow-path {
            stroke-dasharray: 8, 8;
            animation: dash 1s linear infinite;
        }

        @keyframes dash {
            to {
                stroke-dashoffset: -16;
            }
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        .node-active {
            ring: 2px solid #3b82f6;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-900/80 backdrop-blur-md px-4 lg:px-8 py-3.5">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-blue-500 to-amber-400 p-0.5 shadow-lg shadow-indigo-500/20">
                    <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
                        <i class="fa-solid font-bold fa-network-wired text-indigo-400 text-lg"></i>
                    </div>
                </div>
                <div>
                    <h1 class="text-lg font-bold bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-transparent flex items-center gap-2">
                        시스템 아키텍처 인포그래픽
                        <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-mono">v2.5 Live</span>
                    </h1>
                    <p class="text-xs text-slate-400">Enterprise Hybrid Architecture: Firebase + Cloudflare + GCP + Dify + Ollama</p>
                </div>
            </div>

            <!-- Global Action Controls -->
            <div class="flex items-center gap-2.5 flex-wrap justify-center sm:justify-end">
                <!-- Search Box -->
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
                    <input type="text" id="searchInput" placeholder="모듈/기술 검색 (예: Ollama, Firestore...)" 
                           class="bg-slate-800/80 text-xs text-slate-200 pl-8 pr-3 py-2 rounded-lg border border-slate-700 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 w-48 sm:w-60">
                </div>

                <!-- Simulation Trigger Button -->
                <button id="simBtn" onclick="toggleSimulationMenu()" class="text-xs px-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium transition flex items-center gap-2 shadow-lg shadow-indigo-600/20">
                    <i class="fa-solid fa-play text-xs"></i>
                    <span>트래픽 시뮬레이션</span>
                    <i class="fa-solid fa-chevron-down text-[10px]"></i>
                </button>

                <!-- Export/View Toggle Buttons -->
                <button onclick="toggleViewMode()" id="viewModeBtn" class="text-xs px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-table-cells-large"></i>
                    <span id="viewModeText">카드 뷰 전환</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Simulation Dropdown Menu -->
    <div id="simMenu" class="hidden fixed top-16 right-4 sm:right-28 z-50 w-72 glass-panel rounded-xl shadow-2xl p-3 border border-indigo-500/30">
        <div class="text-xs font-semibold text-slate-300 mb-2 px-1 flex items-center justify-between">
            <span>실시간 데이터 플로우 시뮬레이션</span>
            <button onclick="toggleSimulationMenu()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="space-y-1.5">
            <button onclick="runSimulation('enduser')" class="w-full text-left px-3 py-2 rounded-lg bg-slate-800/80 hover:bg-indigo-900/40 border border-slate-700/60 hover:border-indigo-500/50 transition flex items-center gap-2.5 text-xs">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-400 animate-ping"></span>
                <div>
                    <div class="font-semibold text-blue-300">1. End-User 서비스 요청 플로우</div>
                    <div class="text-[10px] text-slate-400">PWA ➔ Hosting ➔ Auth ➔ Dify RAG</div>
                </div>
            </button>

            <button onclick="runSimulation('b2b')" class="w-full text-left px-3 py-2 rounded-lg bg-slate-800/80 hover:bg-amber-900/40 border border-slate-700/60 hover:border-amber-500/50 transition flex items-center gap-2.5 text-xs">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping"></span>
                <div>
                    <div class="font-semibold text-amber-300">2. B2B 파트너 API 통합 & 과금</div>
                    <div class="text-[10px] text-slate-400">B2B Portal ➔ Cloudflare Edge Rate-Limit ➔ Ollama LLM ➔ Firestore Billing Log</div>
                </div>
            </button>

            <button onclick="runSimulation('cicd')" class="w-full text-left px-3 py-2 rounded-lg bg-slate-800/80 hover:bg-emerald-900/40 border border-slate-700/60 hover:border-emerald-500/50 transition flex items-center gap-2.5 text-xs">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <div>
                    <div class="font-semibold text-emerald-300">3. CI/CD 자동 배포 파이프라인</div>
                    <div class="text-[10px] text-slate-400">AI Studio ➔ GitHub Repo ➔ Firebase CLI Deploy</div>
                </div>
            </button>
        </div>
    </div>

    <!-- Stats & Layer Filter Bar -->
    <section class="bg-slate-900/40 border-b border-slate-800/80 py-3 px-4 lg:px-8">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4 text-xs">
            <!-- Filter Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none" id="categoryFilters">
                <button onclick="filterCategory('all')" class="filter-btn active px-3 py-1.5 rounded-full bg-indigo-600 text-white font-medium transition">전체 보기</button>
                <button onclick="filterCategory('user')" class="filter-btn px-3 py-1.5 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 transition">USER LAYER</button>
                <button onclick="filterCategory('gateway')" class="filter-btn px-3 py-1.5 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 transition">GATEWAY & SECURITY</button>
                <button onclick="filterCategory('backend')" class="filter-btn px-3 py-1.5 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 transition">GCP BACKEND</button>
                <button onclick="filterCategory('cicd')" class="filter-btn px-3 py-1.5 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 transition">DEV & CI/CD</button>
            </div>

            <!-- Key Metrics Highlights -->
            <div class="hidden md:flex items-center gap-6 text-slate-400 font-mono">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span>LLM Engine: <strong class="text-slate-200">Local Qwen 2.5 Coder</strong></span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                    <span>Hosting: <strong class="text-slate-200">Firebase Edge Global</strong></span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span>Security: <strong class="text-slate-200">Cloudflare Rate-Limiter</strong></span>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-8">

        <!-- Active Simulation Banner Alert -->
        <div id="simBanner" class="hidden glass-panel border-l-4 border-indigo-500 rounded-r-xl p-4 flex items-center justify-between animate-pulse">
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-indigo-500 animate-ping"></div>
                <div>
                    <h4 class="text-sm font-bold text-indigo-300" id="simTitle">시뮬레이션 진행 중...</h4>
                    <p class="text-xs text-slate-300" id="simDescription">데이터 요청 흐름이 시스템 각 레이어를 통과하고 있습니다.</p>
                </div>
            </div>
            <button onclick="stopSimulation()" class="text-xs px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700">
                중단 <i class="fa-solid fa-stop text-[10px] ml-1"></i>
            </button>
        </div>

        <!-- VIEW MODE 1: VISUAL FLOW ARCHITECTURE GRAPH -->
        <div id="diagramView" class="space-y-6">

            <!-- LAYER 1: USER LAYER -->
            <div class="arch-layer relative glass-panel rounded-2xl p-5 lg:p-6 border border-slate-800 hover:border-blue-500/30 transition-all duration-300" data-category="user">
                <!-- Layer Header Badge -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4 border-b border-slate-800/80 pb-3">
                    <div class="flex items-center gap-2.5">
                        <span class="px-2.5 py-1 rounded-md bg-blue-500/10 text-blue-400 font-mono font-bold text-xs border border-blue-500/20">LAYER 01</span>
                        <h2 class="text-base sm:text-lg font-bold text-slate-100 tracking-wide flex items-center gap-2">
                            <i class="fa-solid fa-users text-blue-400"></i>
                            USER LAYER (유저 & 파트너 접점 레이어)
                        </h2>
                    </div>
                    <span class="text-xs text-slate-400 font-mono">Front-End & Client Interfaces</span>
                </div>

                <!-- Layer Nodes Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">

                    <!-- Node 1.1: End-Users -->
                    <div id="node-enduser" class="node-card glass-panel bg-slate-900/60 rounded-xl p-4 border border-slate-800 hover:border-blue-500/50 transition cursor-pointer group" onclick="showDetail('enduser')">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center text-lg group-hover:scale-110 transition">
                                    <i class="fa-solid fa-mobile-screen-button"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-semibold text-slate-100 group-hover:text-blue-400 transition">End-Users</h3>
                                    <p class="text-xs text-slate-400">PWA / Mobile App / Web Clients</p>
                                </div>
                            </div>
                            <span class="text-[10px] px-2 py-0.5 rounded bg-blue-500/10 text-blue-300 font-mono border border-blue-500/20">Client Apps</span>
                        </div>

                        <!-- Connector Arrow Box -->
                        <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-xs">
                            <span class="text-slate-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-right-long text-blue-400"></i>
                                접속 및 정적 리소스 로드
                            </span>
                            <div class="p-2 rounded-lg bg-slate-800/90 border border-slate-700/70 text-blue-300 font-mono text-[11px] font-medium flex items-center gap-1.5 shadow-sm">
                                <i class="fa-solid fa-fire-flame-curved text-amber-400"></i>
                                Firebase Hosting: MPA & SPA App
                            </div>
                        </div>
                    </div>

                    <!-- Node 1.2: B2B Partners -->
                    <div id="node-b2b" class="node-card glass-panel bg-slate-900/60 rounded-xl p-4 border border-slate-800 hover:border-amber-500/50 transition cursor-pointer group" onclick="showDetail('b2b')">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center text-lg group-hover:scale-110 transition">
                                    <i class="fa-solid fa-handshake"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-semibold text-slate-100 group-hover:text-amber-400 transition">B2B Partners</h3>
                                    <p class="text-xs text-slate-400">API Integrators & Enterprise Clients</p>
                                </div>
                            </div>
                            <span class="text-[10px] px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 font-mono border border-amber-500/20">API Enterprise</span>
                        </div>

                        <!-- Connector Arrow Box -->
                        <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-xs">
                            <span class="text-slate-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-right-long text-amber-400"></i>
                                파트너 관리 & Key 발급
                            </span>
                            <div class="p-2 rounded-lg bg-slate-800/90 border border-slate-700/70 text-amber-300 font-mono text-[11px] font-medium flex items-center gap-1.5 shadow-sm">
                                <i class="fa-solid fa-file-invoice-dollar text-emerald-400"></i>
                                B2B Portal: Deal & Billing UI
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- STREAMING_CHUNK:Building Connection Bridge 1 -> 2... -->
            <!-- Connector Flow Indicator 1 to 2 -->
            <div class="flex justify-center my-[-8px] relative z-10">
                <div class="px-4 py-1.5 rounded-full bg-slate-900 border border-slate-700 text-slate-400 font-mono text-[11px] flex items-center gap-2 shadow-lg">
                    <i class="fa-solid fa-arrow-down text-indigo-400 animate-bounce"></i>
                    <span>HTTPS / REST & WebSocket Request Gateway Transition</span>
                    <i class="fa-solid fa-arrow-down text-indigo-400 animate-bounce"></i>
                </div>
            </div>

            <!-- LAYER 2: API GATEWAY & SECURITY LAYER -->
            <div class="arch-layer relative glass-panel rounded-2xl p-5 lg:p-6 border border-slate-800 hover:border-indigo-500/30 transition-all duration-300" data-category="gateway">
                <!-- Layer Header Badge -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4 border-b border-slate-800/80 pb-3">
                    <div class="flex items-center gap-2.5">
                        <span class="px-2.5 py-1 rounded-md bg-indigo-500/10 text-indigo-400 font-mono font-bold text-xs border border-indigo-500/20">LAYER 02</span>
                        <h2 class="text-base sm:text-lg font-bold text-slate-100 tracking-wide flex items-center gap-2">
                            <i class="fa-solid fa-shield-halved text-indigo-400"></i>
                            API GATEWAY & SECURITY LAYER (보안 & 접근 제어)
                        </h2>
                    </div>
                    <span class="text-xs text-slate-400 font-mono">Authentication & Edge Metering</span>
                </div>

                <!-- Layer Nodes Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">

                    <!-- Node 2.1: Firebase Auth -->
                    <div id="node-auth" class="node-card glass-panel bg-slate-900/60 rounded-xl p-4 border border-slate-800 hover:border-indigo-500/50 transition cursor-pointer group" onclick="showDetail('auth')">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-lg group-hover:scale-110 transition">
                                    <i class="fa-solid fa-key"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-semibold text-slate-100 group-hover:text-indigo-400 transition">Firebase Auth</h3>
                                    <p class="text-xs text-slate-400">OAuth 2.0 / JWT Token Engine</p>
                                </div>
                            </div>
                            <span class="text-[10px] px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-300 font-mono border border-indigo-500/20">Identity</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-3">
                            사용자 인증, 소셜 로그인(Google, GitHub), JWT 토큰 검증 및 세션 관리를 담당하는 보안 모듈.
                        </p>
                        <div class="mt-3 flex flex-wrap gap-1.5 font-mono text-[10px]">
                            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">OAuth 2.0</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">JWT Bearer</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">Role Claims</span>
                        </div>
                    </div>

                    <!-- Node 2.2: Cloudflare Edge -->
                    <div id="node-edge" class="node-card glass-panel bg-slate-900/60 rounded-xl p-4 border border-slate-800 hover:border-orange-500/50 transition cursor-pointer group" onclick="showDetail('edge')">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-orange-500/20 text-orange-400 flex items-center justify-center text-lg group-hover:scale-110 transition">
                                    <i class="fa-solid fa-cloud"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-semibold text-slate-100 group-hover:text-orange-400 transition">Cloudflare / Firebase Edge</h3>
                                    <p class="text-xs text-slate-400">Rate Limiting + API Key Check + Metering</p>
                                </div>
                            </div>
                            <span class="text-[10px] px-2 py-0.5 rounded bg-orange-500/10 text-orange-300 font-mono border border-orange-500/20">Edge Gateway</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-3">
                            API 키 정합성 검증, 과도한 트래픽(DDoS/Spam) 방지, B2B 사용량 실시간 트래킹 및 미터링.
                        </p>
                        <div class="mt-3 flex flex-wrap gap-1.5 font-mono text-[10px]">
                            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">Rate Limiter</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">API Key Validator</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">Usage Metering</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- STREAMING_CHUNK:Building Connection Bridge 2 -> 3... -->
            <!-- Connector Flow Indicator 2 to 3 -->
            <div class="flex justify-center my-[-8px] relative z-10">
                <div class="px-4 py-1.5 rounded-full bg-slate-900 border border-slate-700 text-slate-400 font-mono text-[11px] flex items-center gap-2 shadow-lg">
                    <i class="fa-solid fa-shield-check text-emerald-400"></i>
                    <span>Authenticated & Rate-Checked Traffic Stream</span>
                    <i class="fa-solid fa-arrow-down text-emerald-400 animate-bounce"></i>
                </div>
            </div>

            <!-- LAYER 3: BACKEND ORCHESTRATION LAYER (GCP) -->
            <div class="arch-layer relative glass-panel rounded-2xl p-5 lg:p-6 border border-slate-800 hover:border-emerald-500/30 transition-all duration-300" data-category="backend">
                <!-- Layer Header Badge -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4 border-b border-slate-800/80 pb-3">
                    <div class="flex items-center gap-2.5">
                        <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 font-mono font-bold text-xs border border-emerald-500/20">LAYER 03</span>
                        <h2 class="text-base sm:text-lg font-bold text-slate-100 tracking-wide flex items-center gap-2">
                            <i class="fa-solid fa-server text-emerald-400"></i>
                            BACKEND ORCHESTRATION LAYER (GCP 코어 엔지니어링)
                        </h2>
